{{!
    @template media_supervideo/player
    Isolated embedded media player. No user-specific data is rendered.
}}
<div id="{{elementid}}" class="media-supervideo-player my-2"
     data-type="{{type}}" data-value="{{value}}" data-name="{{name}}"
     data-width="{{width}}" data-height="{{height}}" data-controls="{{controls}}" data-speed="{{speed}}">
    <div class="media-supervideo-host"></div>
    <a class="media-supervideo-fallback" href="{{originalurl}}">{{name}}</a>
</div>
